rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allows authenticated users full access to their own user document and all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
